# ──────────────────────────────────────────────────────────────────────────────
# My Instagram Scheduler — environment configuration
# Copy to .env.local (development) and set the same values in your host's
# environment settings (production). NEVER commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---------------------------------------------------
# Neon, Supabase, Vercel Postgres, or any Postgres. For Neon/Supabase add
# ?sslmode=require to the connection string if required by the provider.
DATABASE_URL=postgresql://user:password@host:5432/instagram_scheduler?sslmode=require

# --- Secrets -----------------------------------------------------------------
# Long random strings, e.g. `openssl rand -hex 32`.
# AUTH_SECRET is reserved for session hardening; TOKEN_ENCRYPTION_KEY encrypts
# Instagram access tokens at rest (AES-256-GCM).
AUTH_SECRET=replace-with-64-random-hex-chars
TOKEN_ENCRYPTION_KEY=replace-with-64-random-hex-chars

# Protects /api/cron/publish. Use a long random value; the same value goes in
# the GitHub Actions secret CRON_SECRET (or your external cron provider's header).
CRON_SECRET=replace-with-64-random-hex-chars

# --- App URL -----------------------------------------------------------------
# Public URL of the deployment (no trailing slash). Used for OAuth redirects.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# Optional: extra allowed OAuth redirect origins (comma separated), e.g. a
# preview URL while testing.
# OAUTH_REDIRECT_ORIGINS=https://your-app.vercel.app

# --- Meta / Instagram (official Instagram Platform API) ----------------------
# Create a Meta app at https://developers.facebook.com/apps (type: Business),
# add the "Instagram" product (Instagram Graph API), then take App ID / Secret.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# OAuth flavor:
#   facebook   (default) — Instagram API with Facebook Login. Requires the
#              Instagram professional account to be linked to a Facebook Page.
#              Scopes: instagram_basic, instagram_content_publish,
#                      pages_show_list, pages_read_engagement
#   instagram  — Instagram API with Instagram Login (Business Login for
#              Instagram). No Facebook Page needed.
#              Scopes: instagram_business_basic, instagram_business_content_publish
INSTAGRAM_OAUTH_MODE=facebook

# Graph API version (pin it; update periodically).
META_GRAPH_API_VERSION=v26.0

# --- Image storage -----------------------------------------------------------
# cloudinary (default, recommended — free tier; required for public image URLs
# that the Instagram API can fetch at publish time)
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=my-instagram-scheduler

# local (development only): stores under ./data/uploads and serves /api/files/*.
# Not suitable for serverless production (no persistent disk).
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=data/uploads

# --- Development / test mode -------------------------------------------------
# When true, Instagram connections & publishing are SIMULATED (clearly labelled
# in the UI and in the data, e.g. media ids like mock_...). Never enable in
# production. Lets you test the full pipeline without Meta credentials.
INSTAGRAM_MOCK_MODE=true
MOCK_INSTAGRAM_USERNAME=my_test_account

# --- Auth / users ------------------------------------------------------------
# Optional. Only needed to create additional accounts after the first owner
# account. If unset, registration is closed after the first user.
# SIGNUP_SECRET=another-long-random-string

# --- Scheduler ---------------------------------------------------------------
# Optional inline worker for always-on hosts (Railway, Render, Fly, VPS).
# Leave OFF on Vercel — use Vercel Cron / GitHub Actions instead.
# RUN_SCHEDULER_INLINE=true
# SCHEDULER_INTERVAL_MS=60000

# Max automatic retry attempts for retryable publish errors (rate limits,
# network/5xx). Permanent errors fail immediately. Manual retry always available.
MAX_AUTO_ATTEMPTS=3
